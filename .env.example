# Kopiere diese Datei nach .env und passe sie bei Bedarf an.

# Hoher, unüblicher Port auf dem Host. Im Nginx Proxy Manager wird auf <Host-IP>:<HOST_PORT> weitergeleitet.
HOST_PORT=63871

# 0.0.0.0 = von anderen Containern/Hosts erreichbar (nötig, wenn der Nginx Proxy Manager selbst in Docker läuft).
# 127.0.0.1 = nur lokal (wenn der Proxy direkt auf dem Host läuft).
BIND_ADDRESS=0.0.0.0
